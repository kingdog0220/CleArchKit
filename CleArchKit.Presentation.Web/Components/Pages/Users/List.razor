@page "/users"

@using CleArchKit.Application.Expands
@using CleArchKit.Application.Users.UseCases.Query
@using CleArchKit.Application.Users.UseCases.Command
@using CleArchKit.Domain.Users.Entities

@inject IUserQueryUseCase UserQueryUseCase
@inject IUserCommandUseCase UserCommandUseCase
@inject IUseCaseExecutor UseCaseExecutor

<PageTitle>ユーザー一覧</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>ユーザー一覧</h1>
    <a href="/users/create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> 新規登録
    </a>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">読み込み中...</span>
        </div>
    </div>
}

else if (users != null && users.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">コード</th>
                    <th scope="col">名称</th>
                    <th scope="col">作成日時</th>
                    <th scope="col">更新日時</th>
                    <th scope="col">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>
                            <small class="text-muted">@user.Id.ToString("N")[..8]...</small>
                        </td>
                        <td>
                            <strong>@user.Code</strong>
                        </td>
                        <td>@user.Name</td>
                        <td>
                            @if (user.CreatedAt.HasValue)
                            {
                                <small>@user.CreatedAt.Value.ToString("yyyy/MM/dd HH:mm")</small>
                            }
                            else
                            {
                                <small class="text-muted">-</small>
                            }
                        </td>
                        <td>
                            @if (user.UpdatedAt.HasValue)
                            {
                                <small>@user.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")</small>
                            }
                            else
                            {
                                <small class="text-muted">-</small>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="/users/update/@user.Id" class="btn btn-outline-primary btn-sm" title="編集">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-danger btn-sm" @onclick="() => ShowDeleteConfirmation(user.Id, user.Name)"
                                    disabled="@isDeleting" title="削除">
                                    @if (isDeleting && deleteTargetUserId == user.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span class="visually-hidden">削除中...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-trash"></i>
                                    }
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <small class="text-muted">合計: @users.Count() 件</small>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i> ユーザーが登録されていません。
    </div>
}

<!-- 削除確認モーダル -->
@if (showDeleteModal)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">削除確認</h5>
                    <button type="button" class="btn-close" @onclick="HideDeleteConfirmation"
                        disabled="@isDeleting"></button>
                </div>
                <div class="modal-body">
                    <p>以下のユーザーを削除してもよろしいですか？</p>
                    <div class="alert alert-warning">
                        <strong>ユーザー名:</strong> @deleteTargetUserName<br>
                        <strong>ID:</strong> @deleteTargetUserId
                    </div>
                    <p class="text-danger"><strong>※この操作は取り消せません。</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideDeleteConfirmation"
                        disabled="@isDeleting">
                        キャンセル
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteUserAsync" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>削除中...</span>
                        }
                        else
                        {
                            <span>削除する</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- トーストコンテナ -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
    @if (showSuccessToast)
    {
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">成功</strong>
            </div>
            <div class="toast-body">
                @successMessage
            </div>
        </div>
    }
    @if (showErrorToast)
    {
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong class="me-auto">エラー</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="HideErrorToast"></button>
            </div>
            <div class="toast-body">
                @errorMessage
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<User>? users;
    private bool isLoading = true;
    private string? errorMessage;

    // 削除関連の状態
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private Guid deleteTargetUserId;
    private string deleteTargetUserName = string.Empty;

    // トースト関連の状態
    private bool showSuccessToast = false;
    private string successMessage = string.Empty;
    private bool showErrorToast = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    /// <summary>
    /// ユーザー一覧を取得する
    /// </summary>
    private async Task LoadUsersAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            users = await UserQueryUseCase.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"ユーザー一覧の取得に失敗しました: {ex.Message}";
            ShowErrorToast(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// 削除確認モーダルを表示する
    /// </summary>
    /// <param name="userId"></param>
    /// <param name="userName"></param>
    private void ShowDeleteConfirmation(Guid userId, string? userName)
    {
        deleteTargetUserId = userId;
        deleteTargetUserName = userName ?? string.Empty;
        showDeleteModal = true;
    }

    /// <summary>
    /// 削除確認モーダルを閉じる
    /// </summary>
    private void HideDeleteConfirmation()
    {
        showDeleteModal = false;
        deleteTargetUserId = Guid.Empty;
        deleteTargetUserName = string.Empty;
    }

    /// <summary>
    /// ユーザーを削除する
    /// </summary>
    private async Task DeleteUserAsync()
    {
        try
        {
            isDeleting = true;
            errorMessage = null;

            await UseCaseExecutor.CreateScope<IUserCommandUseCase>(uc => uc.DeleteAsync(deleteTargetUserId));

            // 削除成功後、ユーザー一覧を再取得
            await LoadUsersAsync();

            // モーダルを閉じる
            HideDeleteConfirmation();

            // 成功メッセージを表示
            ShowSuccessToast("ユーザーを削除しました。");
        }
        catch (Exception ex)
        {
            // モーダルを閉じる
            HideDeleteConfirmation();
            errorMessage = $"ユーザーの削除に失敗しました: {ex.Message}";
            ShowErrorToast(errorMessage);
        }
        finally
        {
            isDeleting = false;

        }
    }

    /// <summary>
    /// トースト（成功）を表示する
    /// </summary>
    /// /// <param name="message"></param>
    private void ShowSuccessToast(string message)
    {
        successMessage = message;
        showSuccessToast = true;

        // 3秒後に自動で非表示
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            await InvokeAsync(() =>
            {
                showSuccessToast = false;
                successMessage = string.Empty;
                StateHasChanged();
            });
        });
    }

    /// <summary>
    /// トースト（エラー）を表示する
    /// </summary>
    /// /// <param name="message"></param>
    private void ShowErrorToast(string message)
    {
        errorMessage = message;
        showErrorToast = true;
    }

    /// <summary>
    /// トースト（エラー）を閉じる
    /// </summary>
    private void HideErrorToast()
    {
        errorMessage = string.Empty;
        showErrorToast = false;
    }

}